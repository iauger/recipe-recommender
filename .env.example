# ── Elasticsearch ─────────────────────────────────────────────────────────────
ES_HOST=http://localhost:9200
ES_INDEX=recipes

# ── Phase 2 model artifacts (required) ────────────────────────────────────────
RECIPES_PATH=data/PROCESSED_search_recipes.parquet
EMBEDDINGS_PATH=data/final_residual_v2_embeddings.pt
MODEL_PATH=data/best_model_residual_v2_all_features_mse.pth
COLUMN_MAPPING_PATH=data/column_mapping.json

# ── Phase 1 gold reviews (required for User History mode) ─────────────────────
# Rename your file to gold_labeled_reviews.parquet, or set the full path here.
GOLD_REVIEWS_PATH=data/gold_labeled_reviews.parquet

# ── Raw Food.com files (optional — recipe display fallback only) ───────────────
FOOD_RAW_RECIPES_PATH=data/RAW_recipes.csv

# ── Phase 2 training inputs (pipeline/train.py only — not needed for the app) ─
# RAW_RECIPES_PATH=data/modeling_recipe.parquet
# RAW_REVIEWS_PATH=data/modeling_reviews.parquet
# PROCESSED_RECIPES_PATH=data/PROCESSED_recipes.parquet
